# Umami (self-hosted stats): copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 24
STATS_DOMAIN=stats.example.com
EDGE_NETWORK=CHANGE-ME
UMAMI_DB_PASSWORD=CHANGE-ME
UMAMI_APP_SECRET=CHANGE-ME
# Replaces the default admin/umami password on first run of umami-init.sh.
UMAMI_ADMIN_PASSWORD=CHANGE-ME
# Websites created by umami-init.sh ("name|domain", space-separated).
UMAMI_WEBSITES="iceguard-site|site.iceguard.cloud demo|demo.iceguard.cloud"
