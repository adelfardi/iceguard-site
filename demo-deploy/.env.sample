# IceGuard public read-only demo: copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 24   (admin token: openssl rand -hex 32)

# ── Public site ──
# Served by the VM's existing reverse proxy (HTTPS), which forwards to iceguard-demo-guard:80.
ICEGUARD_DOMAIN=demo.example.com
# Docker network of that reverse proxy (joined by the guard), e.g. myproxy_default.
EDGE_NETWORK=CHANGE-ME
# Published images ghcr.io/adelfardi/iceguard-{frontend,backend}:<version> (0.3.0+, edge or sha-*).
ICEGUARD_VERSION=0.3.0
# Public read-only UI (banner + client-side write guard), applied when the frontend starts.
ICEGUARD_DEMO_MODE=true
# Required on every non-GET /api request (seeding with curl / seed.py).
ICEGUARD_ADMIN_TOKEN=CHANGE-ME

# ── PostgreSQL: IceGuard state + Polaris persistence (internal only) ──
POSTGRES_PASSWORD=CHANGE-ME

# ── Apache Polaris ──
POLARIS_ROOT_CLIENT_ID=polaris-root
POLARIS_ROOT_CLIENT_SECRET=CHANGE-ME
POLARIS_CATALOG_NAME=polaris-demo
# Extra catalogs (space-separated) created next to it by polaris-init.sh and filled by seed.py.
POLARIS_EXTRA_CATALOGS="finance-prod marketing-analytics data-science-sandbox iot-telemetry-staging hr-people-analytics supply-chain-dev customer-360-uat"
POLARIS_S3_LOCATION=s3://CHANGE-ME-bucket/polaris-demo
POLARIS_S3_REGION=us-east-1
# Long-lived IAM user keys: no session token, nothing to refresh (see README.md).
# Leave both empty on EC2 with an instance profile.
POLARIS_AWS_ACCESS_KEY_ID=CHANGE-ME
POLARIS_AWS_SECRET_ACCESS_KEY=CHANGE-ME
